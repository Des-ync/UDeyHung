# =============================================================================
# TableGH — Environment Variables
# Copy to .env.local for local dev. Never commit .env.local.
# All monetary values stored in pesewas (1 GHS = 100 pesewas).
# =============================================================================

# -----------------------------------------------------------------------------
# App
# -----------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=TableGH
NODE_ENV=development

# -----------------------------------------------------------------------------
# Database — Neon PostgreSQL (https://neon.tech)
# Format: postgresql://user:pass@host/dbname?sslmode=require
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql://tablegh_user:CHANGE_ME@ep-xxx.us-east-2.aws.neon.tech/tablegh?sslmode=require
# Direct URL bypasses PgBouncer for Prisma migrations
DATABASE_URL_UNPOOLED=postgresql://tablegh_user:CHANGE_ME@ep-xxx.us-east-2.aws.neon.tech/tablegh?sslmode=require

# -----------------------------------------------------------------------------
# Redis — Upstash (https://upstash.com)
# Used for: rate limiting, slot-availability cache, waitlist queue
# -----------------------------------------------------------------------------
UPSTASH_REDIS_REST_URL=https://xxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=CHANGE_ME
# For ioredis direct connection (background jobs)
REDIS_URL=rediss://:CHANGE_ME@xxx.upstash.io:6379

# -----------------------------------------------------------------------------
# Auth — Clerk (https://clerk.dev)
# Supports phone OTP + email auth
# -----------------------------------------------------------------------------
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_CHANGE_ME
CLERK_SECRET_KEY=sk_test_CHANGE_ME
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard
CLERK_WEBHOOK_SECRET=whsec_CHANGE_ME

# -----------------------------------------------------------------------------
# Mapbox — https://mapbox.com
# Use a public token for NEXT_PUBLIC (client-side map rendering)
# Restrict token scope to styles:read, tiles:read on the Mapbox dashboard
# -----------------------------------------------------------------------------
NEXT_PUBLIC_MAPBOX_TOKEN=pk.eyJ1IjoiQ0hBTkdFX01FIn0.CHANGE_ME

# -----------------------------------------------------------------------------
# Paystack — https://paystack.com (primary payment provider)
# Test keys start with sk_test_ / pk_test_
# Live keys start with sk_live_ / pk_live_
# Supports cards, bank transfer, USSD, MoMo
# -----------------------------------------------------------------------------
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_test_CHANGE_ME
PAYSTACK_SECRET_KEY=sk_test_CHANGE_ME
# Webhook secret — set in Paystack dashboard under "API Keys & Webhooks"
PAYSTACK_WEBHOOK_SECRET=CHANGE_ME

# -----------------------------------------------------------------------------
# Hubtel — https://hubtel.com (fallback payment + SMS)
# Used for: SMS fallback when Arkesel fails, payment fallback
# Get credentials from: https://developers.hubtel.com
# -----------------------------------------------------------------------------
HUBTEL_CLIENT_ID=CHANGE_ME
HUBTEL_CLIENT_SECRET=CHANGE_ME
HUBTEL_SENDER_ID=TableGH
# Hubtel Receive Money API (MoMo collections)
HUBTEL_ACCOUNT_NUMBER=CHANGE_ME

# -----------------------------------------------------------------------------
# Arkesel — https://arkesel.com (primary SMS provider, Ghanaian rates)
# Get API key from: https://account.arkesel.com/login
# -----------------------------------------------------------------------------
ARKESEL_API_KEY=CHANGE_ME
ARKESEL_SENDER_ID=TableGH

# -----------------------------------------------------------------------------
# WhatsApp Business Cloud API — Meta (primary notification channel)
# Setup: https://developers.facebook.com/docs/whatsapp/cloud-api/get-started
# ~90% WhatsApp penetration in Ghana; this is the PRIMARY channel
# -----------------------------------------------------------------------------
WHATSAPP_PHONE_NUMBER_ID=CHANGE_ME
WHATSAPP_BUSINESS_ACCOUNT_ID=CHANGE_ME
WHATSAPP_ACCESS_TOKEN=CHANGE_ME
# Template IDs registered in Meta Business Manager
WHATSAPP_TEMPLATE_BOOKING_CONFIRMATION=booking_confirmation_v1
WHATSAPP_TEMPLATE_REMINDER_24H=booking_reminder_24h_v1
WHATSAPP_TEMPLATE_REMINDER_2H=booking_reminder_2h_v1
WHATSAPP_TEMPLATE_WAITLIST_AVAILABLE=waitlist_available_v1
WHATSAPP_TEMPLATE_WALKIN_READY=walkin_ready_v1
WHATSAPP_WEBHOOK_VERIFY_TOKEN=CHANGE_ME

# -----------------------------------------------------------------------------
# Cloudflare R2 — https://developers.cloudflare.com/r2/
# Used for: restaurant photos, menu item photos, review photos
# Compatible with AWS S3 SDK
# -----------------------------------------------------------------------------
R2_ACCOUNT_ID=CHANGE_ME
R2_ACCESS_KEY_ID=CHANGE_ME
R2_SECRET_ACCESS_KEY=CHANGE_ME
R2_BUCKET_NAME=tablegh-media
R2_PUBLIC_URL=https://media.tablegh.com
# R2 endpoint format: https://<account_id>.r2.cloudflarestorage.com
R2_ENDPOINT=https://CHANGE_ME.r2.cloudflarestorage.com

# -----------------------------------------------------------------------------
# Sentry — https://sentry.io (error monitoring)
# -----------------------------------------------------------------------------
SENTRY_DSN=https://CHANGE_ME@o0.ingest.sentry.io/0
NEXT_PUBLIC_SENTRY_DSN=https://CHANGE_ME@o0.ingest.sentry.io/0
SENTRY_ORG=tablegh
SENTRY_PROJECT=tablegh-web
SENTRY_AUTH_TOKEN=CHANGE_ME

# -----------------------------------------------------------------------------
# PostHog — https://posthog.com (product analytics)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_POSTHOG_KEY=phc_CHANGE_ME
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# -----------------------------------------------------------------------------
# Internal secrets
# -----------------------------------------------------------------------------
# 32+ char random string: openssl rand -hex 32
CRON_SECRET=CHANGE_ME_32_CHARS_MINIMUM
# Used for signing booking cancellation/modification links
BOOKING_LINK_SECRET=CHANGE_ME_32_CHARS_MINIMUM
